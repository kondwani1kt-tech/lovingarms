APP_NAME="Loving Arms Home Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Lusaka

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# Render injects DB_URL, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD from its managed PostgreSQL database.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email (Resend over HTTPS - works on hosts that block SMTP)
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="Loving Arms Home Care"
NOTIFY_EMAIL=thandoclif@gmail.com
ANALYTICS_ENABLED=false

# Social links shown in the mobile top bar
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_WHATSAPP=https://wa.me/12144125533

# Supabase Auth (staff logins only)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
